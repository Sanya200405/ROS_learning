<?xml version="1.0" ?>

<robot name="robot_1">

    <link name="base_footprint">
        
                
    </link>

   <link name="base_link">

        <visual>

            <material name="yellow">
                <color rgba="1.0 1.0 0.0 1.0"/>
            </material>

        <origin xyz="0 0 0.0" rpy="0 0 0"/>

            <geometry>
            <cylinder length="0.03" radius="0.2"/>
            </geometry>

        </visual>

        <collision>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.03" radius="0.2"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <mass value="10.216"/>
            <inertia ixx="0.1029" ixy="0.0" ixz="0.0" iyy="0.1029" iyz="0.0" izz="0.2043"/>
        </inertial>

    </link>

        <link name="left_wheel">

            <visual>

                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>

                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <cylinder length="0.04" radius="0.05"/>
                </geometry>

            </visual>


            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.04" radius="0.05"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.8514"/>
                <inertia ixx="0.000646" ixy="0.0" ixz="0.0" iyy="0.000646" iyz="0.0" izz="0.001064"/>
            </inertial>

        </link>

        <link name="right_wheel">

            <visual>

                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>

                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <cylinder length="0.04" radius="0.05"/>
                </geometry>

            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.04" radius="0.05"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.8514"/>
                <inertia ixx="0.000646" ixy="0.0" ixz="0.0" iyy="0.000646" iyz="0.0" izz="0.001064"/>
            </inertial>

        </link>

    <link name="castor_1">

        <visual>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>

            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>

        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.419"/>
            <inertia ixx="0.001419" ixy="0.0" ixz="0.0" iyy="0.001419" iyz="0.0" izz="0.001419"/>
        </inertial>

    </link>

    <link name="castor_2">

        <visual>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.419"/>
            <inertia ixx="0.001419" ixy="0.0" ixz="0.0" iyy="0.001419" iyz="0.0" izz="0.001419"/>
        </inertial>

    </link>


    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </joint>

    <!-- <gazebo reference="base_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo> -->

    

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.22 -0.065" rpy="-1.570796 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/White</material>
    </gazebo>    
    
    <transmission name="left_wheel_transmission">
        <type>transmission_interface/SimpleTransmission</type>

        <actuator name="left_wheel_motor">
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>

        <joint name="left_wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.22 -0.065" rpy="1.570796 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/White</material>
    </gazebo>        

    <transmission name="right_wheel_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <actuator name="right_wheel_motor">
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        <joint name="right_wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission>

    <joint name="support_front" type="fixed">
        <parent link="base_link"/>
        <child link="castor_1"/>
        <origin xyz="0.2 0.0 -0.065" rpy="0 0 0"/>
    </joint>

    <gazebo reference="support_front">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <joint name="support_back" type="fixed">
        <parent link="base_link"/>
        <child link="castor_2"/>
        <origin xyz="-0.2 0.0 -0.065" rpy="0 0 0"/>
    </joint>

    <gazebo reference="support_back">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

   <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>30</updateRate>
            <leftJoint>left_wheel_joint</leftJoint>
            <rightJoint>right_wheel_joint</rightJoint>
            <wheelSeparation>0.44</wheelSeparation>
            <wheelDiameter>0.10</wheelDiameter>
            <wheelTorque>20</wheelTorque>
            <wheelAcceleration>1.0</wheelAcceleration>
            <commandTopic>cmd_vel</commandTopic>
            <odometryTopic>odom</odometryTopic>
            <odometryFrame>odom</odometryFrame>
            <robotBaseFrame>base_footprint</robotBaseFrame>
            <odometrySource>world</odometrySource>
            <publishWheelTF>false</publishWheelTF>
            <publishOdomTF>true</publishOdomTF> 
            <publishTf>true</publishTf> 
            <publishWheelJointState>true</publishWheelJointState>
            <legacyMode>false</legacyMode>
            <rosDebugLevel>na</rosDebugLevel>
        </plugin>
    </gazebo>

</robot>