    <link name="back_right_support">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.025 0.025 0.15"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.025 0.025 0.15"/>
            </geometry>
        </collision>  
        
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.2531"/>
            <inertia ixx="0.000488" ixy="0.0" ixz="0.0" iyy="0.000488" iyz="0.0" izz="0.0000264"/>
        </inertial>
        
    </link>

     <link name="back_left_support">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.025 0.025 0.15"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.025 0.025 0.15"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.2531"/>
            <inertia ixx="0.000488" ixy="0.0" ixz="0.0" iyy="0.000488" iyz="0.0" izz="0.0000264"/>
        </inertial>

    </link>

    <link name="top_level">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.3" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1" />
            </material>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.3" length="0.04"/>
            </geometry> 
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="30.536"/>
            <inertia ixx="0.6912" ixy="0.0" ixz="0.0" iyy="0.6912" iyz="0.0" izz="1.3741"/>
        </inertial>
    </link> 

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.16" rpy="0.0 0.0 0.0"/>
    </joint>  

    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.17 0.185 -0.075" rpy="-1.570796 0.0 0.0"/>
        <axis xyz="0 0 1"/> 
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="front_left_wheel">
        <mu1>1000</mu1>
        <mu2>1000</mu2>
        <kp>100000</kp>
        <kd>1</kd>
        <minDepth>0.001</minDepth>  
        <maxVel>0.1</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <!-- <transmission name="front_left_wheel_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <actuator name="front_left_wheel_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        <joint name="front_left_wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission> 
 -->

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.17 -0.185 -0.075" rpy="1.570796 0.0 0.0"/>
        <axis xyz="0 0 -1"/> 
    </joint>

    <gazebo reference="front_right_wheel">
        <mu1>1000</mu1>
        <mu2>1000</mu2>
        <kp>100000</kp>
        <kd>1</kd>
        <minDepth>0.001</minDepth>  
        <maxVel>0.1</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <!-- <transmission name="front_right_wheel_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <actuator name="front_right_wheel_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        <joint name="front_right_wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission> -->

    <joint name="back_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_left_wheel"/>
        <origin xyz="-0.17 0.185 -0.075" rpy="-1.570796 0.0 0.0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="back_left_wheel">
        <mu1>1000</mu1>
        <mu2>1000</mu2>
        <kp>100000</kp>
        <kd>1</kd>
        <minDepth>0.001</minDepth>  
        <maxVel>0.1</maxVel>
        <material>Gazebo/White</material>
    </gazebo>  
    
    <!-- <transmission name="back_left_wheel_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <actuator name="back_left_wheel_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        <joint name="back_left_wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission> -->

    <joint name="back_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_right_wheel"/>
        <origin xyz="-0.17 -0.185 -0.075" rpy="1.570796 0.0 0.0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <gazebo reference="back_right_wheel">
        <mu1>1000</mu1>
        <mu2>1000</mu2>
        <kp>100000</kp>
        <kd>1</kd>
        <minDepth>0.001</minDepth>  
        <maxVel>0.1</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <!-- <transmission name="back_right_wheel_transmission">
        <type>transmission_interface/SimpleTransmission</type>
        <actuator name="back_right_wheel_motor">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        <joint name="back_right_wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission> -->

    <joint name="front_right_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_right_support"/>
        <origin xyz="0.2375 -0.1375 0.15" rpy="0.0 0.0 0.0"/>
    </joint>


    <gazebo reference="front_right_support_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <joint name="front_left_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_left_support"/>
        <origin xyz="0.2375 0.1375 0.15" rpy="0.0 0.0 0.0"/>
    </joint> 

    <gazebo reference="front_left_support_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    
    <joint name="back_right_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_right_support"/>
        <origin xyz="-0.2375 -0.1375 0.15" rpy="0.0 0.0 0.0"/>
    </joint>
    
    <gazebo reference="back_right_support_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>   

    <joint name="back_left_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_left_support"/>
        <origin xyz="-0.2375 0.1375 0.15" rpy="0.0 0.0 0.0"/>
    </joint>
    
    <gazebo reference="back_left_support_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>   

    <joint name="top_level_joint" type="fixed">
        <parent link="base_link"/>
        <child link="top_level"/>
        <origin xyz="0.0 0.0 0.225" rpy="0.0 0.0 0.0"/>
    </joint>

    <gazebo reference="top_level_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo>
        <plugin name="skid_steer_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
            <updateRate>30.0</updateRate>
            <robotNamespace>/</robotNamespace>
            <leftFrontJoint>front_left_wheel_joint</leftFrontJoint>
            <rightFrontJoint>front_right_wheel_joint</rightFrontJoint>
            <leftRearJoint>back_left_wheel_joint</leftRearJoint>
            <rightRearJoint>back_right_wheel_joint</rightRearJoint>
            <wheelSeparation>0.34</wheelSeparation>
            <wheelDiameter>0.16</wheelDiameter>
            <robotBaseFrame>base_footprint</robotBaseFrame>
            <torque>50</torque>
            <topicName>cmd_vel</topicName>
            <broadcastTF>true</broadcastTF>
            <odometryTopic>odom</odometryTopic>
            <odometryFrame>odom</odometryFrame>
            <covariance_x>0.0001</covariance_x>
            <covariance_y>0.0001</covariance_y>
            <covariance_yaw>0.01</covariance_yaw>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <robotNamespace>/</robotNamespace>
            <jointName>
                front_left_wheel_joint, front_right_wheel_joint, back_left_wheel_joint, back_right_wheel_joint
            </jointName>
            <updateRate>30.0</updateRate>
            <alwaysOn>true</alwaysOn>
        </plugin>
    </gazebo>
    


</robot>
