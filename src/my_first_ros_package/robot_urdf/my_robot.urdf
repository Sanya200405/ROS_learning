<?xml version="1.0" ?>
<robot name="robot_1">
    <link name="base_footprint">
        
    </link>
   <link name="base_link">
        <visual>
            <material name="yellow">
                <color rgba="1.0 1.0 0.0 1.0"/>
            </material>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
            <cylinder length="0.03" radius="0.2"/>
            </geometry>
        </visual>
    </link>

        <link name="left_wheel">
            <visual>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.04" radius="0.05"/>
                </geometry>
            </visual>
        </link>

        <link name="right_wheel">
            <visual>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.04" radius="0.05"/>
                </geometry>
            </visual>
    </link>

    <link name="castor_1">
        <visual>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </visual>
    </link>

    <link name="castor_2">
        <visual>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </visual>
    </link>


    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </joint>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.22 -0.065" rpy="-1.570796 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.22 -0.065" rpy="1.570796 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="support_front" type="fixed">
        <parent link="base_link"/>
        <child link="castor_1"/>
        <origin xyz="0.2 0.0 -0.06" rpy="0 0 0"/>
    </joint>

    <joint name="support_back" type="fixed">
        <parent link="base_link"/>
        <child link="castor_2"/>
        <origin xyz="-0.2 0.0 -0.06" rpy="0 0 0"/>
    </joint>

</robot>