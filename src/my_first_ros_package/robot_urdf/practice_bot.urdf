            <inertia ixx="0.000488" ixy="0.0" ixz="0.0" iyy="0.000488" iyz="0.0" izz="0.0000264"/>
        </inertial>

    </link>


    <link name="front_left_support">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.025 0.025 0.15"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
